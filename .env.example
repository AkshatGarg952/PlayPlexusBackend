# Copy to .env and fill in. Never commit the real .env.

# --- Required ---------------------------------------------------------------

# MongoDB connection string (Atlas or local).
DATABASE_URL=mongodb://127.0.0.1:27017/playplexus

# Secret used to sign JWTs. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# --- Server -----------------------------------------------------------------

PORT=3000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API and open sockets.
CORS_ORIGINS=http://localhost:3000

# How long an access token stays valid (zeit/ms format).
JWT_EXPIRES_IN=7d

# --- Image uploads (Cloudinary) ---------------------------------------------
# Optional. Without these, uploads are skipped and accounts are created without
# a picture; everything else works.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional tuning --------------------------------------------------------

# How often pending requests are swept for expiry, in milliseconds.
EXPIRY_JOB_INTERVAL_MS=60000

# Comma-separated LibreTranslate mirrors used by the assistant.
LIBRETRANSLATE_URLS=https://libretranslate.de,https://translate.argosopentech.com
